# Local: the NestJS API from `pnpm start` in apps/api. Production builds must use an `admin-api.` host.
VITE_API_BASE_URL=http://localhost:3000
# Cloudflare Turnstile site key, written into the bundle. Blank: the fake widget, which only an API with TURNSTILE_MODE=fake accepts.
# A production build (`pnpm build`) fails without it. Cloudflare's test key (always passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
