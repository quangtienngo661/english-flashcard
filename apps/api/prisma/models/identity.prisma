model User {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.VarChar(254)
  emailVerifiedAt  DateTime? @map("email_verified_at") @db.Timestamptz
  staffRole        String?   @map("staff_role")
  nativeLanguage   String?   @map("native_language")
  timezone         String
  status           String    @default("active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  loginLockedUntil DateTime? @map("login_locked_until") @db.Timestamptz
  mustChangePassword Boolean @default(false) @map("must_change_password")
  givenName        String?   @map("given_name") @db.VarChar(50)
  familyName       String?   @map("family_name") @db.VarChar(50)
  birthDate        DateTime? @map("birth_date") @db.Date
  termsAcceptedAt  DateTime? @map("terms_accepted_at") @db.Timestamptz
  termsVersion     String?   @map("terms_version")
  lockedAt         DateTime? @map("locked_at") @db.Timestamptz
  lockedBy         String?   @map("locked_by") @db.Uuid
  lockReason       String?   @map("lock_reason") @db.VarChar(500)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz
  deletingSince    DateTime? @map("deleting_since") @db.Timestamptz
  // Who started the deletion ('self' | 'admin' | 'cleanup'); the retry job writes it to deleted_accounts.by and sends no mail for 'cleanup'.
  deletingBy       String?   @map("deleting_by") @db.VarChar(16)
  avatarUrl        String?   @map("avatar_url") @db.VarChar(2048)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  passwordCredential PasswordCredential?
  identities         UserIdentity[]
  sessionChains      SessionChain[]
  otpCodes           OtpCode[]
  otpFailureWindows  OtpFailureWindow[]

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
}

model PasswordCredential {
  userId    String   @id @map("user_id") @db.Uuid
  hash      String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model SessionChain {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  clientType   String    @map("client_type")
  deviceLabel  String?   @map("device_label") @db.VarChar(100)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastUsedAt   DateTime  @map("last_used_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokeReason String?   @map("revoke_reason")
  authMethod   String    @default("password") @map("auth_method") @db.VarChar(16)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@map("session_chains")
}

model RefreshToken {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chainId             String    @map("chain_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  rotatedAt           DateTime? @map("rotated_at") @db.Timestamptz
  successorId         String?   @map("successor_id") @db.Uuid
  successorCiphertext String?   @map("successor_ciphertext")
  graceUntil          DateTime? @map("grace_until") @db.Timestamptz

  chain SessionChain @relation(fields: [chainId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OtpCode {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  purpose       String
  codeHmac      String    @map("code_hmac")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  attempts      Int       @default(0)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model OtpFailureWindow {
  userId      String    @map("user_id") @db.Uuid
  purpose     String
  windowStart DateTime  @map("window_start") @db.Timestamptz
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, purpose])
  @@map("otp_failure_windows")
}

model UserIdentity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  provider  String   @db.VarChar(16)
  subject   String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([userId, provider])
  @@map("user_identities")
}

// No foreign key: the user row is gone. Holds only the id, when and by whom, so a restore from backup can delete the account again (D21).
model DeletedAccount {
  userId    String   @id @map("user_id") @db.Uuid
  deletedAt DateTime @map("deleted_at") @db.Timestamptz
  by        String   @db.VarChar(16)

  @@index([deletedAt])
  @@map("deleted_accounts")
}

