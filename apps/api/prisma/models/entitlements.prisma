// Entitlements & Usage (Bước 5, design §6). Every user id is a plain UUID: no relation crosses a module boundary.
// CHECKs on the enum columns and the partial unique indexes live in the migration (as practice.prisma).

// One grant by staff (design §10): a Pro plan, or custom limits that replace the plan's numbers for the keys present.
model EntitlementGrant {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  // plan | limits; plan = 'pro' exactly when kind = 'plan', limits exactly when kind = 'limits' (CHECKs).
  kind              String
  plan              String?
  // Keys practice_sessions_per_day, ai_practice_per_cycle, ai_lookup_per_cycle; only the keys present replace the plan's.
  limits            Json?
  startsAt          DateTime  @map("starts_at") @db.Timestamptz
  endsAt            DateTime  @map("ends_at") @db.Timestamptz
  reason            String
  grantedBy         String    @map("granted_by") @db.Uuid
  grantedByRole     String    @map("granted_by_role")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy         String?   @map("revoked_by") @db.Uuid
  // 'replaced' when a new plan grant took its place (D32).
  revokeReason      String?   @map("revoke_reason")
  // What happened to the user's paid renewal when this Pro grant was made (D32): turned_off | not_supported | null.
  paidRenewalAction String?   @map("paid_renewal_action")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  changes EntitlementGrantChange[]

  @@index([userId, endsAt])
  @@index([grantedBy, createdAt])
  @@map("entitlement_grants")
}

// One change of a grant's dates by staff (D38); append-only.
model EntitlementGrantChange {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grantId       String   @map("grant_id") @db.Uuid
  changedBy     String   @map("changed_by") @db.Uuid
  changedByRole String   @map("changed_by_role")
  oldStartsAt   DateTime @map("old_starts_at") @db.Timestamptz
  newStartsAt   DateTime @map("new_starts_at") @db.Timestamptz
  oldEndsAt     DateTime @map("old_ends_at") @db.Timestamptz
  newEndsAt     DateTime @map("new_ends_at") @db.Timestamptz
  reason        String
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  grant EntitlementGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId, createdAt])
  @@map("entitlement_grant_changes")
}

// One subscription at one provider (design §9.4). Every subscription renews automatically (D35): no renewal column.
model Subscription {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  provider               String
  environment            String
  externalSubscriptionId String    @map("external_subscription_id")
  interval               String
  status                 String
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz
  // D30: the provider started a trial the rules refused; the user is Free until the first charge.
  trialDenied            Boolean   @default(false) @map("trial_denied")
  paymentFingerprint     String?   @map("payment_fingerprint")
  currentPeriodStart     DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz
  graceEndsAt            DateTime? @map("grace_ends_at") @db.Timestamptz
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  pendingInterval        String?   @map("pending_interval")
  quotaAnchorAt          DateTime? @map("quota_anchor_at") @db.Timestamptz
  // The transaction that paid the current period (plan choice 3; D34 "refund of the current period", D37).
  currentTransactionId   String?   @map("current_transaction_id")
  lastEventAt            DateTime? @map("last_event_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([provider, environment, externalSubscriptionId])
  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

// One notification received from a provider (the event inbox, design §9.2).
model BillingEvent {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider               String
  environment            String
  dedupeKey              String    @unique @map("dedupe_key")
  externalEventId        String    @map("external_event_id")
  externalSubscriptionId String?   @map("external_subscription_id")
  // Normalized type (design §9.3); kind: state | additive (R1).
  type                   String
  kind                   String
  transactionId          String?   @map("transaction_id")
  occurredAt             DateTime  @map("occurred_at") @db.Timestamptz
  receivedAt             DateTime  @default(now()) @map("received_at") @db.Timestamptz
  // The event's app_user_id when it is a lower-case uuid, else null; user_id is set once the applier recognises the user.
  appUserId              String?   @map("app_user_id") @db.Uuid
  userId                 String?   @map("user_id") @db.Uuid
  subscriptionId         String?   @map("subscription_id") @db.Uuid
  // Null when a §9.3 field is missing: the applier's signal for "missing fields".
  payload                Json?
  // May hold the buyer's email: never logged (SR10); cleared after RAW_PAYLOAD_RETENTION_DAYS (R23).
  rawPayload             Json?     @map("raw_payload")
  status                 String
  error                  String?
  attempts               Int       @default(0)
  processedAt            DateTime? @map("processed_at") @db.Timestamptz

  @@index([status, receivedAt])
  @@index([provider, environment, transactionId])
  @@index([userId])
  @@index([appUserId])
  @@index([subscriptionId])
  @@map("billing_events")
}

// One trial already used (design §8): once per user, and once per payment fingerprint at a provider (partial unique, migration).
model TrialHistory {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  provider           String
  paymentFingerprint String?  @map("payment_fingerprint")
  startedAt          DateTime @map("started_at") @db.Timestamptz

  @@map("trial_history")
}

// One payment event a learner can see in their transaction history (learner UI design §8.9). Staff grants are not copied
// here: the reads merge them from entitlement_grants. No backfill: subscriptions older than the table have no rows (GI10).
model BillingTransaction {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  subscriptionId        String?   @map("subscription_id") @db.Uuid
  // purchase | renewal | plan_change | refund | trial (CHECK).
  kind                  String
  plan                  String
  // month | year | null (CHECK).
  interval              String?
  // Smallest currency unit (99.000 VND → 99000, 4.99 USD → 499); null when the provider did not say.
  amountMinor           BigInt?   @map("amount_minor")
  // ISO 4217, null with amount_minor.
  currency              String?
  occurredAt            DateTime  @map("occurred_at") @db.Timestamptz
  periodStart           DateTime  @map("period_start") @db.Timestamptz
  periodEnd             DateTime? @map("period_end") @db.Timestamptz
  // succeeded | refunded | pending | reversed (CHECK); pending is for real providers later.
  status                String
  provider              String
  environment           String
  providerTransactionId String?   @map("provider_transaction_id")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, environment, providerTransactionId, kind])
  @@index([userId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@map("billing_transactions")
}

// One line of the usage ledger (design §7). No counter table (D28): what is left is always counted from these rows.
// Partial uniques on (user_id, pool, operation_id) per kind live in the migration.
model UsageRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  pool          String
  operationId   String    @map("operation_id")
  // use | credit; a credit row is always confirmed.
  kind          String
  status        String
  // caller | expired | late-confirm-free (R7).
  releaseReason String?   @map("release_reason")
  // practice_sessions: the learner's date; AI pools: the date in AI_DAY_ZONE.
  localDate     DateTime? @map("local_date") @db.Date
  systemDate    DateTime? @map("system_date") @db.Date
  reservedAt    DateTime? @map("reserved_at") @db.Timestamptz
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz
  releasedAt    DateTime? @map("released_at") @db.Timestamptz
  creditedAt    DateTime? @map("credited_at") @db.Timestamptz
  // The report id behind a refund.
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, pool, confirmedAt])
  @@index([pool, systemDate])
  @@map("usage_records")
}

// One email to send (design §14): one row per (kind, subject, period, recipient) so a mail is never sent twice (R9).
model EntitlementNotice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?   @map("user_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  kind            String
  // The subscription id.
  subjectKey      String    @map("subject_key")
  periodKey       String    @map("period_key")
  state           String
  dueAt           DateTime  @map("due_at") @db.Timestamptz
  windowEndsAt    DateTime  @map("window_ends_at") @db.Timestamptz
  attempts        Int       @default(0)
  lastErrorAt     DateTime? @map("last_error_at") @db.Timestamptz
  sentAt          DateTime? @map("sent_at") @db.Timestamptz

  @@unique([kind, subjectKey, periodKey, recipientUserId])
  @@index([state, dueAt])
  @@index([userId])
  @@index([recipientUserId])
  @@map("entitlement_notices")
}

// The fake provider's own state (design 9.1): what a real provider would hold on its side. Never used in production (R17).
model FakeBillingSubscription {
  externalSubscriptionId String    @id @map("external_subscription_id")
  userId                 String    @map("user_id") @db.Uuid
  status                 String
  interval               String
  currentPeriodStart     DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamptz
  trialEndsAt            DateTime? @map("trial_ends_at") @db.Timestamptz
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  lastOccurredAt         DateTime  @map("last_occurred_at") @db.Timestamptz
  endTrialCalledAt       DateTime? @map("end_trial_called_at") @db.Timestamptz
  cancelCalledAt         DateTime? @map("cancel_called_at") @db.Timestamptz
  // The transaction of the current period, so the fake answers fetchState after a refund like a provider would (D39).
  currentTransactionId   String?   @map("current_transaction_id")
  // Every event the fake was sent; its truth is these folded in occurred_at order, like a provider that saw them happen.
  history                Json      @default("[]")
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("fake_billing_subscriptions")
}

// One time a learner pressed "Buy" for a prepaid Pro period (launch prep B design §3.2). Not a subscription: nothing renews.
// CHECKs (environment, period_months, status, review_reason, paid_via, order_code range) are in the migration.
model BillingOrder {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // anonymised on account deletion, like billing_transactions.
  userId             String    @map("user_id") @db.Uuid
  provider           String
  // production with the real payOS, sandbox with the fake.
  environment        String
  // From billing_order_code_seq; unique with provider.
  orderCode          BigInt    @map("order_code")
  // 'WM' + 7 base32 characters of order_code: what the payer types into the bank transfer.
  description        String
  periodMonths       Int       @map("period_months")
  amountMinor        BigInt    @map("amount_minor")
  currency           String
  // pending | paid | expired | cancelled | failed | needs_review | closed.
  status             String
  // amount-short | amount-over | late-payment | account-deleted | extra-payment | reconcile-mismatch | provider-mismatch | null.
  reviewReason       String?   @map("review_reason")
  // webhook | reconcile | manual; null until the first period.
  paidVia            String?   @map("paid_via")
  paymentLinkId      String?   @map("payment_link_id")
  checkoutUrl        String?   @map("checkout_url")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz
  checkedAt          DateTime? @map("checked_at") @db.Timestamptz
  // Only when money arrived after the account was deleted (§3.11); cleared when staff close the order or after 90 days.
  refundPayerName    String?   @map("refund_payer_name")
  refundPayerAccount String?   @map("refund_payer_account")
  refundPayerBank    String?   @map("refund_payer_bank")
  refundSavedAt      DateTime? @map("refund_saved_at") @db.Timestamptz
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz
  resolvedBy         String?   @map("resolved_by") @db.Uuid
  resolutionNote     String?   @map("resolution_note")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  payments BillingOrderPayment[]
  periods  PrepaidPeriod[]

  @@unique([provider, orderCode])
  @@index([status, createdAt])
  @@index([userId])
  @@map("billing_orders")
}

// One transfer (or one staff confirmation) counted for an order. payment_key is the identity of the payment (design §3.4):
// payos:<environment>:<orderCode>:<reference> or manual:<order_id>.
model BillingOrderPayment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  paymentKey   String   @unique @map("payment_key")
  // webhook | reconcile | manual.
  source       String
  reference    String
  amountMinor  BigInt   @map("amount_minor")
  // payOS transactionDateTime as sent (no time zone); null for staff.
  providerTime String?  @map("provider_time")
  // opened-period | attached | counted | flagged | refund-needed.
  outcome      String
  periodId     String?  @map("period_id") @db.Uuid
  confirmedBy  String?  @map("confirmed_by") @db.Uuid
  reason       String?
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz

  order  BillingOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // A period deleted with an account leaves the money record behind (ON DELETE SET NULL).
  period PrepaidPeriod?  @relation("PeriodOpenedByPayment", fields: [periodId], references: [id], onDelete: SetNull)
  opened PrepaidPeriod[] @relation("PeriodPayment")

  @@index([orderId])
  @@index([periodId])
  @@map("billing_order_payments")
}

// One paid Pro period; may start in the future. starts_at and ends_at are fixed once, when the period opens (§3.7).
model PrepaidPeriod {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  orderId      String    @map("order_id") @db.Uuid
  paymentId    String    @map("payment_id") @db.Uuid
  startsAt     DateTime  @map("starts_at") @db.Timestamptz
  endsAt       DateTime  @map("ends_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order    BillingOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment  BillingOrderPayment   @relation("PeriodPayment", fields: [paymentId], references: [id], onDelete: Cascade)
  payments BillingOrderPayment[] @relation("PeriodOpenedByPayment")

  @@index([userId, endsAt])
  @@index([orderId])
  @@index([paymentId])
  @@map("prepaid_periods")
}

// The fake payOS's own state, so getCheckout answers in the worker too (launch prep B design §3.3). No column points at a user.
// CHECK on status (the seven payOS values) is in the migration.
model FakePayosLink {
  orderCode     BigInt   @id @map("order_code")
  paymentLinkId String   @map("payment_link_id")
  amount        Int
  status        String
  expiresAt     DateTime @map("expires_at") @db.Timestamptz
  // [{ reference, amount, transactionDateTime, payer }] as payOS lists them.
  transactions  Json     @default("[]")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("fake_payos_links")
}
