    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "compromise": "14.18.0",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.15",
