  "type": "module",
  "scripts": {
    "admin:grant": "node dist/cli/admin-grant.js",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:scale": "vitest run --config ./vitest.config.e2e-scale.ts",
    "db:setup": "prisma migrate deploy && prisma generate --sql",
    "run:dev": "node scripts/run-dev.mjs",
    "smoke:buoc-2": "node scripts/smoke-buoc-2.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
