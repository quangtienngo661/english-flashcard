DATABASE_URL=postgresql://dev:dev@localhost:5434/english_learning
# Connection pool of each process (the API and the worker each open their own). Defaults shown; uncomment to change.
# DATABASE_POOL_MAX=20
# How long a query waits for a free connection before it fails (ms).
# DATABASE_POOL_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6380

IMPORT_MAX_ROWS=20000
IMPORT_MAX_BYTES=10485760
EXPORT_MAX_ROWS=5000
IMPORT_LEASE_SECONDS=60
IMPORT_HEARTBEAT_SECONDS=20
IMPORT_RECONCILE_SECONDS=30
IMPORT_ROW_RETRIES=3
IMPORT_JOB_ATTEMPTS=3
IMPORT_FILE_RETENTION_DAYS=30
JOB_QUEUE_PREFIX=wordmet
# Test speed overrides only; production uses these defaults.
# IMPORT_JOB_BACKOFF_MS=5000
# IMPORT_ROW_RETRY_BASE_MS=200
# How often the worker checks who needs a reminder email (seconds; default 900 = 15 minutes).
# REMINDER_TICK_SECONDS=900
# First retry delay after a transient SMTP error on a reminder (ms; doubles per attempt, 3 attempts).
# REMINDER_RETRY_BACKOFF_MS=60000
# Workers are enabled in code by the worker entry point or tests, never by an env var.

# Replace each secret placeholder with a separate output of node scripts/gen-secret.mjs.
# JWT_KEYS is an ordered kid:base64url list; the first key signs tokens.
JWT_KEYS=k1:REPLACE_WITH_GENERATED_JWT_SECRET
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=english-learning
OTP_HMAC_KEY=REPLACE_WITH_GENERATED_OTP_HMAC_SECRET
RATE_LIMIT_HMAC_KEY=REPLACE_WITH_GENERATED_RATE_LIMIT_HMAC_SECRET
REFRESH_GRACE_KEY=REPLACE_WITH_GENERATED_REFRESH_GRACE_SECRET
ACCESS_TOKEN_TTL_SECONDS=900

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost
# Optional SMTP credentials; Mailpit needs neither.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_DAILY_BUDGET=1500
MAIL_BUDGET_KEY=global

TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PROBLEM_TYPE_BASE=http://localhost:3000/problems/
ADMIN_APP_URL=http://localhost:5173
# Origin of the learner app (apps/web); reminder emails link to <LEARNER_APP_URL>/<vi|en>/app/settings.
LEARNER_APP_URL=http://localhost:3001
MAINTENANCE_ENABLED=true

# Billing (design 9.1). The fake provider signs events with BILLING_FAKE_SECRET (`pnpm billing:fake-event`);
# never enable it in production: BILLING_PRODUCTION=true with BILLING_FAKE_ENABLED=true refuses to start.
BILLING_PRODUCTION=false
BILLING_FAKE_ENABLED=true
BILLING_FAKE_SECRET=REPLACE_WITH_GENERATED_BILLING_FAKE_SECRET
# false runs the path of a provider without fetchState (R10).
BILLING_FAKE_FETCH_STATE=true

# AI gateway (Bước 6, design §13). Keys are secrets: never commit or paste them. Empty = that provider is not configured.
# The fake provider (models fake:*) is for local work and the smoke; BILLING_PRODUCTION=true with AI_FAKE_ENABLED=true refuses to start.
# OPENAI_CUSTOM_HEADERS and ANTHROPIC_CUSTOM_HEADERS must stay unset or empty: if either is set, the app refuses to start (D29).
AI_FAKE_ENABLED=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
