DATABASE_URL=postgresql://dev:dev@localhost:5434/english_learning
# Connection pool of each process (the API and the worker each open their own). Defaults shown; uncomment to change.
# DATABASE_POOL_MAX=20
# How long a query waits for a free connection before it fails (ms).
# DATABASE_POOL_TIMEOUT_MS=5000
REDIS_URL=redis://localhost:6380

IMPORT_MAX_ROWS=20000
IMPORT_MAX_BYTES=10485760
EXPORT_MAX_ROWS=10000
IMPORT_LEASE_SECONDS=60
IMPORT_HEARTBEAT_SECONDS=20
IMPORT_RECONCILE_SECONDS=30
IMPORT_ROW_RETRIES=3
IMPORT_JOB_ATTEMPTS=3
IMPORT_FILE_RETENTION_DAYS=30
JOB_QUEUE_PREFIX=wordmet
# Test speed overrides only; production uses these defaults.
# IMPORT_JOB_BACKOFF_MS=5000
# IMPORT_ROW_RETRY_BASE_MS=200
# How often the worker checks who needs a reminder email (seconds; default 900 = 15 minutes).
# REMINDER_TICK_SECONDS=900
# First retry delay after a transient SMTP error on a reminder (ms; doubles per attempt, 3 attempts).
# REMINDER_RETRY_BACKOFF_MS=60000
# Workers are enabled in code by the worker entry point or tests, never by an env var.

# Replace each secret placeholder with a separate output of node scripts/gen-secret.mjs.
# JWT_KEYS is an ordered kid:base64url list; the first key signs tokens.
JWT_KEYS=k1:REPLACE_WITH_GENERATED_JWT_SECRET
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=english-learning
OTP_HMAC_KEY=REPLACE_WITH_GENERATED_OTP_HMAC_SECRET
RATE_LIMIT_HMAC_KEY=REPLACE_WITH_GENERATED_RATE_LIMIT_HMAC_SECRET
REFRESH_GRACE_KEY=REPLACE_WITH_GENERATED_REFRESH_GRACE_SECRET
ACCESS_TOKEN_TTL_SECONDS=900

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@localhost
# Optional SMTP credentials; Mailpit needs neither.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_DAILY_BUDGET=1500
MAIL_BUDGET_KEY=global

TRUST_PROXY=false
# 3001: the learner app (pnpm dev:app). 127.0.0.1:5173: admin opened by IP while testing the learner app, so the two keep
# separate refresh cookies (docs/deliveries/giao-dien-nguoi-hoc-test-flow.md).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173
PROBLEM_TYPE_BASE=http://localhost:3000/problems/
ADMIN_APP_URL=http://localhost:5173
# Origin of the learner app (apps/web); reminder emails link to <LEARNER_APP_URL>/<vi|en>/app/settings.
LEARNER_APP_URL=http://localhost:3001
# Names the Terms/Privacy version a learner accepts at registration.
TERMS_VERSION=2026-10-20
MAINTENANCE_ENABLED=true

# Cloudflare Turnstile on register, login and OTP requests (launch prep A). No default: the API and the worker refuse to start without it.
#   real = checks tokens with Cloudflare (needs the secret and the hostnames below)
#   fake = no network; any well-formed token passes except `fake-turnstile-fail` (smokes, local work)
#   off  = no check at all (unit tests only)
# `fake` and `off` refuse to start together with BILLING_PRODUCTION=true. Cloudflare's test keys (always pass / always fail):
# sitekey 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA (pass) or 2x0000000000000000000000000000000AA (fail).
TURNSTILE_MODE=fake
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames siteverify may report: wordmet.com,www.wordmet.com,admin.wordmet.com in production.
TURNSTILE_ALLOWED_HOSTNAMES=

# Billing (design 9.1). The fake provider signs events with BILLING_FAKE_SECRET (`pnpm billing:fake-event`);
# never enable it in production: BILLING_PRODUCTION=true with BILLING_FAKE_ENABLED=true refuses to start.
# BILLING_PRODUCTION is required, with no default: true in production, false everywhere else; unset, the API and worker refuse to start.
BILLING_PRODUCTION=false
BILLING_FAKE_ENABLED=true
BILLING_FAKE_SECRET=REPLACE_WITH_GENERATED_BILLING_FAKE_SECRET
# false runs the path of a provider without fetchState (R10).
BILLING_FAKE_FETCH_STATE=true

# payOS, one-time VietQR payments (launch prep B, design §3.3). Real: set all three (secrets: never commit or paste them), or none.
# The fake is for local work and the smoke; it signs its webhooks with BILLING_FAKE_SECRET, and BILLING_PRODUCTION=true with
# PAYOS_FAKE_ENABLED=true refuses to start.
PAYOS_FAKE_ENABLED=true
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# AI gateway (Bước 6, design §13). Keys are secrets: never commit or paste them. Empty = that provider is not configured.
# The fake provider (models fake:*) is for local work and the smoke; BILLING_PRODUCTION=true with AI_FAKE_ENABLED=true refuses to start.
# OPENAI_CUSTOM_HEADERS and ANTHROPIC_CUSTOM_HEADERS must stay unset or empty: if either is set, the app refuses to start (D29).
AI_FAKE_ENABLED=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google sign-in (Bước 8). Client id and secret come from Google Cloud (docs/deliveries/buoc-8-test-flow.md); empty = Google unavailable.
# OAUTH_COOKIE_KEY seals the short-lived Google cookies: generate it with `node scripts/gen-secret.mjs`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback
OAUTH_COOKIE_KEY=REPLACE_WITH_GENERATED_OAUTH_COOKIE_KEY
# A fake Google page for tests and the smoke only; BILLING_PRODUCTION=true with GOOGLE_FAKE_ENABLED=true refuses to start.
GOOGLE_FAKE_ENABLED=false

# Pre-made pronunciation audio (round C). Everything below is optional: without it the app keeps the browser voice.
# GOOGLE_TTS_CREDENTIALS is a secret: the base64 of the service account JSON (client_email, private_key, project_id); never commit or paste it.
# The voices are Google voice names; the language code is their first five characters (en-GB, en-US).
GOOGLE_TTS_CREDENTIALS=
TTS_VOICE_UK=en-GB-Wavenet-B
TTS_VOICE_US=en-US-Wavenet-D
# A fake provider (a tiny fixed mp3) for local work and the smoke; BILLING_PRODUCTION=true with TTS_FAKE_ENABLED=true refuses to start.
TTS_FAKE_ENABLED=false
# Cloudflare R2 through its S3 API: set all four (secrets: never commit them), or none. AUDIO_PUBLIC_BASE_URL is the public address of the bucket.
AUDIO_STORAGE_ENDPOINT=
AUDIO_STORAGE_BUCKET=
AUDIO_STORAGE_ACCESS_KEY_ID=
AUDIO_STORAGE_SECRET_ACCESS_KEY=
AUDIO_PUBLIC_BASE_URL=
# A local folder instead of R2, served by GET /v1/dev/audio/:file (set AUDIO_PUBLIC_BASE_URL=http://localhost:3000/v1/dev/audio);
# BILLING_PRODUCTION=true with AUDIO_STORAGE_FAKE_ENABLED=true refuses to start.
AUDIO_STORAGE_FAKE_ENABLED=false
AUDIO_STORAGE_FAKE_DIR=.tmp/audio
