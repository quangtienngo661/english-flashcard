# TLS and reverse proxy for the API (deploy runbook M3). Caddy asks Let's Encrypt for a certificate for each name in CADDY_SITES
# and renews it; the DNS records of those names must point at this server (grey cloud) before the first start.
{
	email {$ACME_EMAIL}
}

{$CADDY_SITES:api.wordmet.com, admin-api.wordmet.com} {
	reverse_proxy api:3000
	# JSON access log for daily-report.sh (5xx count, p95 latency). It holds client IPs, kept 7 days (privacy policy, M7).
	log {
		output file /var/log/caddy/access.log {
			roll_keep_for 168h
		}
		format json
	}
}
