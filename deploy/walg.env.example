# WAL-G settings for the postgres service (restore-safety design 3.1).
# Copy to $WORDMET_HOME/walg.env on the VPS: chmod 600, only the postgres service reads it (R5).
# api and worker must never get this file: the R2 key can overwrite the backups.
# One dedicated R2 bucket for WAL and base backups, with a token limited to that bucket.
# Note: `s3://wordmet-wal/spike` is the production archive despite its name; never delete or rename it.
WALG_S3_PREFIX=s3://<bucket>/<prefix>
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_FORCE_PATH_STYLE=true
AWS_REGION=auto
AWS_ACCESS_KEY_ID=<r2-access-key-id>
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
WALG_COMPRESSION_METHOD=brotli
