# Settings of the operator scripts (backup.sh, watch.sh, daily-report.sh): copy to /srv/wordmet/ops.env on the VPS (chmod 600).
# Names and placeholders only. The scripts stop and name the key when one is missing.

# R2 bucket wordmet-backups. Its token: Object Read & Write, applied to this bucket only (backup.sh writes, lists and removes old copies).
R2_BACKUP_ENDPOINT=https://<Account ID>.r2.cloudflarestorage.com
R2_BACKUP_BUCKET=wordmet-backups
R2_BACKUP_ACCESS_KEY_ID=<token of wordmet-backups: access key id>
R2_BACKUP_SECRET_ACCESS_KEY=<token of wordmet-backups: secret access key>

# Alert and daily report emails, sent through the Resend HTTP API (not through the app).
ALERT_RESEND_API_KEY=<Resend API key>
ALERT_FROM=Wordmet ops <ops@wordmet.com>
ALERT_TO=<owner email>
