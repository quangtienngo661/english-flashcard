# Production environment of the API and the worker: copy to /srv/wordmet/.env on the VPS (chmod 600) and fill every <…>.
# Names and placeholders only: never commit real values, never paste them into a chat. Same keys as apps/api/.env.example.
# <generate> = one separate output of `node scripts/gen-secret.mjs` (in apps/api); it is URL-safe, so it also fits POSTGRES_PASSWORD.

# ---- Read by docker compose (deploy/compose.prod.yml), not by the app ----------------------------------------------------
POSTGRES_USER=wordmet
POSTGRES_PASSWORD=<generate>
POSTGRES_DB=wordmet
# Let's Encrypt account email for the api. and admin-api. certificates.
ACME_EMAIL=<owner email>

# ---- Database and queues: compose sets these two for the containers; the values here are only a reminder ------------------
DATABASE_URL=postgresql://wordmet:<POSTGRES_PASSWORD>@postgres:5432/wordmet
REDIS_URL=redis://redis:6379

IMPORT_MAX_ROWS=20000
IMPORT_MAX_BYTES=10485760
EXPORT_MAX_ROWS=10000
IMPORT_LEASE_SECONDS=60
IMPORT_HEARTBEAT_SECONDS=20
IMPORT_RECONCILE_SECONDS=30
IMPORT_ROW_RETRIES=3
IMPORT_JOB_ATTEMPTS=3
IMPORT_FILE_RETENTION_DAYS=30
JOB_QUEUE_PREFIX=wordmet

# ---- Identity ------------------------------------------------------------------------------------------------------------
JWT_KEYS=k1:<generate>
JWT_ISSUER=https://api.wordmet.com
JWT_AUDIENCE=english-learning
OTP_HMAC_KEY=<generate>
RATE_LIMIT_HMAC_KEY=<generate>
REFRESH_GRACE_KEY=<generate>
ACCESS_TOKEN_TTL_SECONDS=900
TERMS_VERSION=2026-10-20

# ---- Mail: Resend over SMTP (the API key is the password). Check from the VPS first: `nc -vz smtp.resend.com 465` -----------
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=<Resend API key>
SMTP_FROM=Wordmet <no-reply@wordmet.com>
# Resend Pro: 50 000 mails a month. OTP, reminders and receipts share this daily budget.
MAIL_DAILY_BUDGET=1500
MAIL_BUDGET_KEY=global

# ---- HTTP ----------------------------------------------------------------------------------------------------------------
# Caddy reaches the API over the Docker network, a private address.
TRUST_PROXY=uniquelocal
CORS_ORIGINS=https://wordmet.com,https://www.wordmet.com,https://admin.wordmet.com
PROBLEM_TYPE_BASE=https://api.wordmet.com/problems/
ADMIN_APP_URL=https://admin.wordmet.com
LEARNER_APP_URL=https://wordmet.com
# Set per service by compose (api false, worker true); listed so the key set matches apps/api/.env.example.
MAINTENANCE_ENABLED=false

# ---- Turnstile -----------------------------------------------------------------------------------------------------------
TURNSTILE_MODE=real
TURNSTILE_SECRET_KEY=<Turnstile secret of the production widget>
TURNSTILE_ALLOWED_HOSTNAMES=wordmet.com,www.wordmet.com,admin.wordmet.com

# ---- Billing: real payOS only. Any *_FAKE_ENABLED=true together with BILLING_PRODUCTION=true stops the API at start ---------
BILLING_PRODUCTION=true
BILLING_FAKE_ENABLED=false
BILLING_FAKE_SECRET=<generate>
BILLING_FAKE_FETCH_STATE=true
PAYOS_FAKE_ENABLED=false
PAYOS_CLIENT_ID=<payOS client id>
PAYOS_API_KEY=<payOS API key>
PAYOS_CHECKSUM_KEY=<payOS checksum key>

# ---- AI ------------------------------------------------------------------------------------------------------------------
AI_FAKE_ENABLED=false
OPENAI_API_KEY=<OpenAI production key>
ANTHROPIC_API_KEY=<Anthropic production key>

# ---- Google sign-in (on from launch, owner 14/11/2026) -----------------------------------------------------------------------
GOOGLE_CLIENT_ID=<OAuth client id>
GOOGLE_CLIENT_SECRET=<OAuth client secret>
GOOGLE_REDIRECT_URI=https://api.wordmet.com/v1/auth/google/callback
OAUTH_COOKIE_KEY=<generate>
GOOGLE_FAKE_ENABLED=false

# ---- Google voices, files on R2 (on from launch, owner 13/11/2026) ------------------------------------------------------------
GOOGLE_TTS_CREDENTIALS=<base64 of the service account JSON, one line>
TTS_VOICE_UK=en-GB-Wavenet-B
TTS_VOICE_US=en-US-Wavenet-D
TTS_FAKE_ENABLED=false
AUDIO_STORAGE_ENDPOINT=https://<Account ID>.r2.cloudflarestorage.com
AUDIO_STORAGE_BUCKET=wordmet-audio
AUDIO_STORAGE_ACCESS_KEY_ID=<token of wordmet-audio: access key id>
AUDIO_STORAGE_SECRET_ACCESS_KEY=<token of wordmet-audio: secret access key>
AUDIO_PUBLIC_BASE_URL=https://audio.wordmet.com
AUDIO_STORAGE_FAKE_ENABLED=false
AUDIO_STORAGE_FAKE_DIR=.tmp/audio
