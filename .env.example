# Settings for the Docker stack (docker-compose.yml). `pnpm bootstrap` copies this to .env and fills each
# REPLACE_WITH_GENERATED_* with its own random value; you only fill in what is marked "YOU" below.
# .env is git-ignored. Never commit real values. (Running the apps on the host instead? apps/api/.env.example.)

# --- Ports on this machine ---------------------------------------------------------------------------------------------
API_PORT=3000
ADMIN_PORT=5173
WEB_PORT=3001
# Postgres, Redis and Mailpit (SMTP and web UI) also publish on this machine; change one if another project holds it.
POSTGRES_PORT=5434
REDIS_PORT=6380
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Postgres (the container is created with these; change them only before its first start) ----------------------------
POSTGRES_DB=english_learning
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# --- Secrets: generated by `pnpm bootstrap` ---------------------------------------------------------------------------
# JWT_KEYS is an ordered kid:base64url list; the first key signs tokens.
JWT_KEYS=k1:REPLACE_WITH_GENERATED_JWT_SECRET
OTP_HMAC_KEY=REPLACE_WITH_GENERATED_OTP_HMAC_SECRET
RATE_LIMIT_HMAC_KEY=REPLACE_WITH_GENERATED_RATE_LIMIT_HMAC_SECRET
REFRESH_GRACE_KEY=REPLACE_WITH_GENERATED_REFRESH_GRACE_SECRET
BILLING_FAKE_SECRET=REPLACE_WITH_GENERATED_BILLING_FAKE_SECRET
# Seals the short-lived Google sign-in cookies (Bước 8).
OAUTH_COOKIE_KEY=REPLACE_WITH_GENERATED_OAUTH_COOKIE_KEY

# --- AI providers: YOU ------------------------------------------------------------------------------------------------
# Empty = that provider is not configured; Admin > AI > Models then offers only the fake one. Real keys mean real calls
# and real cost once an operation is switched to a real model. Restart the api container after changing them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OPENAI_CUSTOM_HEADERS and ANTHROPIC_CUSTOM_HEADERS must stay unset: if either is set, the app refuses to start.

# --- Google sign-in: YOU (docs/deliveries/buoc-8-test-flow.md has the Google Cloud steps) ----------------------------------
# Empty = the "Tiếp tục với Google" button answers "unavailable". The redirect URI must be the same one entered in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback
# A fake Google page for tests only; refuses to start together with BILLING_PRODUCTION=true.
GOOGLE_FAKE_ENABLED=false

# --- Everything below has a working default; change only when you need to ---------------------------------------------
JWT_AUDIENCE=english-learning
ACCESS_TOKEN_TTL_SECONDS=900
TERMS_VERSION=2026-10-20
MAINTENANCE_ENABLED=true
TRUST_PROXY=false

IMPORT_MAX_ROWS=20000
IMPORT_MAX_BYTES=10485760
EXPORT_MAX_ROWS=5000
IMPORT_LEASE_SECONDS=60
IMPORT_HEARTBEAT_SECONDS=20
IMPORT_RECONCILE_SECONDS=30
IMPORT_ROW_RETRIES=3
IMPORT_JOB_ATTEMPTS=3
IMPORT_FILE_RETENTION_DAYS=30
JOB_QUEUE_PREFIX=wordmet

# Mail goes to Mailpit (http://localhost:8025); no credentials needed.
SMTP_FROM=no-reply@localhost
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_DAILY_BUDGET=1500
MAIL_BUDGET_KEY=global

# Fake billing and fake AI are for local work. BILLING_PRODUCTION=true with either fake flag on refuses to start.
BILLING_PRODUCTION=false
BILLING_FAKE_ENABLED=true
BILLING_FAKE_FETCH_STATE=true
AI_FAKE_ENABLED=true
